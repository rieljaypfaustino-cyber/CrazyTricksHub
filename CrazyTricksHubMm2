local function powerfulVoidFling(targetPlayer)
    if not targetPlayer or not IsAlive(targetPlayer) or not IsAlive(LocalPlayer) then 
        notify("FLING ERROR", "Walang nahanap na valid target player!", 3)
        return 
    end
    
    local char = LocalPlayer.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local targetChar = targetPlayer.Character
    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
    
    if not hrp or not targetHrp or not hum then return end
    
    local oldCFrame = hrp.CFrame
    notify("🌀 POWER-FLING ACTIVATED", "Flinging " .. targetPlayer.Name .. " to Void...", 2)
    
    -- Anti-Self-Fling / Anti-Death Protections
    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    
    local startTime = tick()
    local angle = 0
    local connection
    
    connection = RunService.Heartbeat:Connect(function()
        if (tick() - startTime > 1.8) or not IsAlive(targetPlayer) or not IsAlive(LocalPlayer) or not targetHrp.Parent then
            connection:Disconnect()
            
            -- Reset physics and safely return to original position
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = oldCFrame
            
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            notify("FLING COMPLETE", targetPlayer.Name .. " has been sent out of the map!", 3)
            return
        end
        
        angle = angle + 45
        local offset = Vector3.new(math.cos(math.rad(angle)) * 0.8, 0, math.sin(math.rad(angle)) * 0.8)
        
        hrp.CanCollide = false
        hrp.CFrame = CFrame.new(targetHrp.Position + offset, targetHrp.Position)
        
        -- Override target's kinetic movement to void
        hrp.Velocity = Vector3.new(999999, 999999, 999999)
        hrp.RotVelocity = Vector3.new(999999, 999999, 999999)
        
        targetHrp.AssemblyLinearVelocity = Vector3.new(999999, -999999, 999999)
        targetHrp.AssemblyAngularVelocity = Vector3.new(999999, 999999, 999999)
    end)
end

