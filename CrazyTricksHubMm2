-- Gumagana kapag IKAW ang Sheriff o Hero (may gun tool, kahit anong skin),
-- at may detected na Murderer sa round. Automatic equip + aim + shoot.

local LastAutoShotTime = 0

-- Kunin ang gun tool mo kahit anong skin (Character muna, tapos Backpack)
local function getLocalGunTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find("gun") then
            return tool
        end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find("gun") then
                return tool
            end
        end
    end
    return nil
end

-- Check kung ikaw ang Sheriff o Hero (may gun ka sa round)
local function isLocalSheriffOrHero()
    if not IsInRoundMap() or not IsAlive(LocalPlayer) then return false end
    if not HasGunTool(LocalPlayer) then return false end
    -- Kung may gun ka sa round map at hindi ikaw ang murderer, gun holder ka (Sheriff o Hero)
    if HasKnifeTool(LocalPlayer) then return false end
    return true
end

local function handleAutoShootMurderer()
    if not Settings.AutoShootMurderer then return end
    if not isLocalSheriffOrHero() then return end
    if not Roles.Murderer or not IsAlive(Roles.Murderer) then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local myHrp = char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    
    local mHrp = Roles.Murderer.Character:FindFirstChild("HumanoidRootPart")
    if not mHrp then return end
    
    local dist = (myHrp.Position - mHrp.Position).Magnitude
    if dist > Settings.ShootDistance then return end
    
    -- Safety delay para hindi ma-flag ng anti-cheat (walang spam-shoot)
    if tick() - LastAutoShotTime < Settings.AutoShootDelay then return end
    
    local gun = getLocalGunTool()
    if not gun then return end
    
    -- I-equip muna kung nasa Backpack
    if gun.Parent ~= char then
        char.Humanoid:EquipTool(gun)
        task.wait(0.05)
    end
    
    -- Aim sa Murderer (head level para accurate)
    local targetPos = Roles.Murderer.Character:FindFirstChild("Head") and Roles.Murderer.Character.Head.Position or mHrp.Position
    myHrp.CFrame = CFrame.new(myHrp.Position, Vector3.new(targetPos.X, myHrp.Position.Y, targetPos.Z))
    
    gun:Activate()
    LastAutoShotTime = tick()
end

