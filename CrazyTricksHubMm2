local function removeESP(player)
    if player and player.Character then
        local hl = player.Character:FindFirstChild("CrazyESP")
        if hl then hl:Destroy() end
        local head = player.Character:FindFirstChild("Head")
        if head then
            local bg = head:FindFirstChild("RoleTag")
            if bg then bg:Destroy() end
        end
    end
end

local function applyESP(player, color, roleTitle)
    if not player.Character or player == LocalPlayer then return end
    local char = player.Character
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if not hum or hum.Health <= 0 then 
        removeESP(player)
        return 
    end
    
    local hl = char:FindFirstChild("CrazyESP") or Instance.new("Highlight")
    hl.Name = "CrazyESP"
    hl.FillColor = color
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.35
    hl.Parent = char
    
    local head = char:FindFirstChild("Head")
    if head then
        local bg = head:FindFirstChild("RoleTag") or Instance.new("BillboardGui")
        bg.Name = "RoleTag"
        bg.Adornee = head
        bg.Size = UDim2.new(0, 180, 0, 40)
        bg.StudsOffset = Vector3.new(0, 3, 0)
        bg.AlwaysOnTop = true
        
        local lbl = bg:FindFirstChild("RoleText") or Instance.new("TextLabel")
        lbl.Name = "RoleText"
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local distStuds = (hrp and myHrp) and math.floor((myHrp.Position - hrp.Position).Magnitude) or 0
        lbl.Text = string.format("%s\n@%s [%d studs]", roleTitle, player.Name, distStuds)
        lbl.TextColor3 = color
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.TextStrokeTransparency = 0.2
        lbl.Parent = bg
        bg.Parent = head
    end
end

local function scanRoles()
    local roundActive = IsInRoundMap()
    
    if roundActive ~= LastRoundActiveState then
        LastRoundActiveState = roundActive
        if roundActive then
            notify("🎮 ROUND STARTED", "Ina-analyze ang mga role...", 3)
            OriginalSheriffPlayer = nil
            CurrentGunHolder = nil
            IsEvacuated = false
        else
            OriginalSheriffPlayer = nil
            CurrentGunHolder = nil
            IsEvacuated = false
            if SafePlatform then SafePlatform:Destroy() SafePlatform = nil end
        end
    end
    
    Roles.Murderer = nil
    Roles.Sheriff = nil
    Roles.Hero = nil

    for _, p in pairs(Players:GetPlayers()) do
        if IsAlive(p) and IsPlayerInRoundMap(p) then
            if HasKnifeTool(p) then Roles.Murderer = p end
            if HasGunTool(p) then
                if OriginalSheriffPlayer == nil then OriginalSheriffPlayer = p end
                CurrentGunHolder = p
            end
        end
    end
    
    if OriginalSheriffPlayer and IsAlive(OriginalSheriffPlayer) then Roles.Sheriff = OriginalSheriffPlayer end
    if CurrentGunHolder and CurrentGunHolder ~= OriginalSheriffPlayer and IsAlive(CurrentGunHolder) then Roles.Hero = CurrentGunHolder end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if not IsAlive(p) then
                applyESP(p, Color3.fromRGB(200, 200, 200), "⚪ UNASSIGNED (DEAD)")
            elseif not IsPlayerInRoundMap(p) then
                applyESP(p, Color3.fromRGB(200, 200, 200), "⚪ UNASSIGNED / LOBBY")
            else
                if p == Roles.Murderer then
                    applyESP(p, Color3.fromRGB(255, 40, 40), "🔪 MURDERER")
                elseif p == Roles.Sheriff then
                    applyESP(p, Color3.fromRGB(40, 140, 255), "🔫 SHERIFF")
                elseif p == Roles.Hero then
                    applyESP(p, Color3.fromRGB(255, 215, 0), "🟡 HERO")
                else
                    applyESP(p, Color3.fromRGB(40, 255, 100), "😇 INNOCENT")
                end
            end
        end
    end
end

