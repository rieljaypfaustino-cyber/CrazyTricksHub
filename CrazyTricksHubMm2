local function instantKillAll()
    if not IsInRoundMap() or not IsAlive(LocalPlayer) then 
        notify("KILL ALL ERROR", "Kailangan nasa active round map ka!", 3)
        return 
    end

    local myChar = LocalPlayer.Character
    local knife = nil
    for _, item in pairs(myChar:GetChildren()) do
        if item:IsA("Tool") and (item.Name == "Knife" or item.Name:lower():find("knife")) then knife = item break end
    end
    if not knife then
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name == "Knife" or item.Name:lower():find("knife")) then knife = item break end
        end
    end
    
    if not knife then
        notify("MURDERER ONLY", "Kailangan may hawak kang Knife tool sa Backpack!", 3)
        return
    end
    
    if knife.Parent == LocalPlayer.Backpack then
        myChar.Humanoid:EquipTool(knife)
    end
    
    local blade = knife:FindFirstChild("Handle") or knife:FindFirstChild("Part") or myChar.HumanoidRootPart
    local oldPos = myChar.HumanoidRootPart.CFrame
    notify("⚡ INSTANT KILL ALL", "Executing Elimination Matrix...", 2)
    
    for _, victim in pairs(Players:GetPlayers()) do
        if victim ~= LocalPlayer and IsAlive(victim) and IsPlayerInRoundMap(victim) then
            local vHrp = victim.Character.HumanoidRootPart
            myChar.HumanoidRootPart.CFrame = vHrp.CFrame * CFrame.new(0, 0, 1.2)
            
            task.wait(0.02)
            knife:Activate()
            firetouchinterest(blade, vHrp, 0)
            firetouchinterest(blade, vHrp, 1)
        end
    end
    
    task.wait(0.1)
    myChar.HumanoidRootPart.CFrame = oldPos
end

local function executeSilentCombat()
    if not IsInRoundMap() or not IsAlive(LocalPlayer) then return end
    local myChar = LocalPlayer.Character
    local myHrp = myChar.HumanoidRootPart
    
    local gun = myChar:FindFirstChild("Gun")
    if Settings.SilentAim and gun and Roles.Murderer and IsAlive(Roles.Murderer) then
        local targetHead = Roles.Murderer.Character:FindFirstChild("Head") or Roles.Murderer.Character.HumanoidRootPart
        if (myHrp.Position - targetHead.Position).Magnitude <= Settings.ShootDistance then
            myHrp.CFrame = CFrame.new(myHrp.Position, Vector3.new(targetHead.Position.X, myHrp.Position.Y, targetHead.Position.Z))
            gun:Activate()
        end
    end
    
    local knife = myChar:FindFirstChild("Knife")
    if Settings.SilentKnife and knife then
        local closestTarget = nil
        local closestDist = math.huge
        
        for _, victim in pairs(Players:GetPlayers()) do
            if victim ~= LocalPlayer and IsAlive(victim) and IsPlayerInRoundMap(victim) then
                local vHead = victim.Character:FindFirstChild("Head") or victim.Character.HumanoidRootPart
                local dist = (myHrp.Position - vHead.Position).Magnitude
                if dist < closestDist and dist <= Settings.ShootDistance then
                    closestDist = dist
                    closestTarget = vHead
                end
            end
        end
        
        if closestTarget then
            myHrp.CFrame = CFrame.new(myHrp.Position, Vector3.new(closestTarget.Position.X, myHrp.Position.Y, closestTarget.Position.Z))
            knife:Activate()
        end
    end
end

