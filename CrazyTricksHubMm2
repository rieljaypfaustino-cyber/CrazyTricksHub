local function IsAlive(player)
    player = player or LocalPlayer
    return player and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 and player.Character:FindFirstChild("HumanoidRootPart")
end

local function IsPlayerInRoundMap(player)
    if not IsAlive(player) then return false end
    local lobby = Workspace:FindFirstChild("RegularLobby") or Workspace:FindFirstChild("Lobby")
    local hrp = player.Character.HumanoidRootPart
    
    if lobby then
        local lPos = lobby:IsA("Model") and lobby:GetPivot().Position or lobby.Position
        return (hrp.Position - lPos).Magnitude > 220
    end
    return true
end

local function IsInRoundMap()
    return IsPlayerInRoundMap(LocalPlayer)
end

local function HasGunTool(player)
    if not IsAlive(player) then return false end
    local bp = player:FindFirstChild("Backpack")
    local char = player.Character
    
    if bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name == "Gun" or tool.Name:lower():find("gun")) then return true end
        end
    end
    if char then
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name == "Gun" or tool.Name:lower():find("gun")) then return true end
        end
    end
    return false
end

local function HasKnifeTool(player)
    if not IsAlive(player) then return false end
    local bp = player:FindFirstChild("Backpack")
    local char = player.Character
    
    if bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name == "Knife" or tool.Name:lower():find("knife")) then return true end
        end
    end
    if char then
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name == "Knife" or tool.Name:lower():find("knife")) then return true end
        end
    end
    return false
end

