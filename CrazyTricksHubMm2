-- State Cache Invisibility System
local function applyInvisibility(char, enable)
    if enable then
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                if InvisibilityCache[obj] == nil then
                    InvisibilityCache[obj] = {
                        Transparency = obj.Transparency,
                        LocalTransparencyModifier = obj:IsA("BasePart") and obj.LocalTransparencyModifier or nil
                    }
                end
                obj.Transparency = 1
                if obj:IsA("BasePart") then obj.LocalTransparencyModifier = 1 end
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") then
                if InvisibilityCache[obj] == nil then
                    InvisibilityCache[obj] = { Enabled = obj.Enabled }
                end
                obj.Enabled = false
            end
        end
    else
        for obj, state in pairs(InvisibilityCache) do
            if obj and obj.Parent then
                if state.Transparency ~= nil then obj.Transparency = state.Transparency end
                if state.LocalTransparencyModifier ~= nil and obj:IsA("BasePart") then 
                    obj.LocalTransparencyModifier = state.LocalTransparencyModifier 
                end
                if state.Enabled ~= nil then obj.Enabled = state.Enabled end
            end
        end
        table.clear(InvisibilityCache)
    end
end

-- Trap Bypass & Knife Throw Dodge
local function handleMM2Utilities()
    if not IsAlive(LocalPlayer) then return end
    local char = LocalPlayer.Character
    local hrp = char.HumanoidRootPart

    -- Trap Bypass
    if Settings.TrapBypass then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name:lower():find("trap") or obj.Name:lower():find("bear")) then
                if (hrp.Position - obj.Position).Magnitude <= 12 then
                    obj.CanCollide = false
                end
            end
        end
    end

    -- Knife Throw Dodge
    if Settings.KnifeDodge and Roles.Murderer and IsAlive(Roles.Murderer) then
        for _, proj in pairs(Workspace:GetChildren()) do
            if proj:IsA("BasePart") and (proj.Name == "FlyingKnife" or proj.Name == "Knife" or proj.Name:lower():find("knife")) then
                local dist = (hrp.Position - proj.Position).Magnitude
                if dist <= 20 then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.FloorMaterial ~= Enum.Material.Air then
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        hrp.CFrame = hrp.CFrame * CFrame.new(math.random(-5, 5), 0, -3)
                    end
                end
            end
        end
    end
end

local function handleMovementAndInvisibility()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    -- Invisibility System Integration
    applyInvisibility(char, Settings.Invisible)
    
    if Settings.StealthSpeed and hum then 
        hum.WalkSpeed = Settings.SpeedValue 
    else
        if hum and hum.WalkSpeed ~= 16 then hum.WalkSpeed = 16 end
    end
    
    if Settings.Noclip then
        for _, p in pairs(char:GetChildren()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    
    if Settings.StealthFly and Flying then
        local cam = Workspace.CurrentCamera
        local flyDir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then flyDir = flyDir + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then flyDir = flyDir - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then flyDir = flyDir - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then flyDir = flyDir + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then flyDir = flyDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then flyDir = flyDir - Vector3.new(0, 1, 0) end
        
        hrp.Velocity = Vector3.zero
        hrp.CFrame = hrp.CFrame + (flyDir * (Settings.FlySpeed / 50))
    end
end

